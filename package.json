{
  "name": "drizzle-cubrid",
  "version": "0.2.1",
  "description": "Drizzle ORM dialect for CUBRID database",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --reporter=verbose",
    "integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tests/native/tsconfig.json",
    "check:boundary": "node scripts/check-dialect-boundary.mjs src && npm run build && node scripts/check-dialect-boundary.mjs package --pack",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "cubrid",
    "database",
    "orm",
    "sql",
    "typescript"
  ],
  "author": "Gyeongjun Paik <paikend@gmail.com>",
  "contributors": [
    {
      "name": "Gyeongjun Paik",
      "email": "paikend@gmail.com"
    },
    {
      "name": "Yeongseon Choe",
      "email": "yeongseon.choe@gmail.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubrid-lab/drizzle-cubrid.git"
  },
  "bugs": {
    "url": "https://github.com/cubrid-lab/drizzle-cubrid/issues"
  },
  "homepage": "https://github.com/cubrid-lab/drizzle-cubrid#readme",
  "peerDependencies": {
    "cubrid-client": ">=1.4.0 <2.0.0",
    "drizzle-orm": ">=0.44.1 <0.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@vitest/coverage-v8": "^5.1.0",
    "cubrid-client": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
